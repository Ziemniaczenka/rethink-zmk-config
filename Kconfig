DT_COMPAT_RETHINK_TRACKPOINT := rethink,trackpoint

config RETHINK_TRACKPOINT
	bool "Pointing stick on the adapter (PS/2)"
	default $(dt_compat_enabled,$(DT_COMPAT_RETHINK_TRACKPOINT))
	depends on RETHINK_ADAPTER
	select GPIO
	select INPUT
	select POLL
	select REGULATOR
	help
	  Power, reset, PS/2 link and pointing of the rethink,trackpoint stick.
	  The link is bit-banged: an interrupt on each falling clock edge. The
	  stick starts after boot and reports movement and buttons as input
	  events (zmk,input-listener, ZMK_POINTING). Without an answer from a
	  stick it is powered off again. Keys: &tp (rethink,behavior-trackpoint).

if RETHINK_TRACKPOINT

config RETHINK_TRACKPOINT_IDLE_OFF_MIN
	int "Minutes unused before the stick is powered off"
	default 10
	range 0 1440
	help
	  Neither the stick nor a key used for this long: the stick is powered
	  off (about 19 mA from the battery with a 5 V T420 stick). The next
	  key press starts it again, in about 0.3 s. 0 keeps it
	  on. &tp TP_OFF switches it off until &tp TP_ON.

config RETHINK_TRACKPOINT_GUARD
	bool "Leave the stick off after a switch-on that reset the board"
	default y
	depends on SETTINGS
	help
	  Switching the stick's supply (TP_3V3) on charges its capacitors and
	  the adapter's at once: a surge from the battery input. From a weak
	  source (a worn or nearly empty cell, a power profiler, a bench supply
	  through a multimeter) the board resets, and starting the stick again
	  resets it again: a boot loop. With this, a switch-on on battery is
	  marked in flash and the mark cleared once the board came through it
	  (two writes per switch-on on battery). A board that boots with the
	  mark still there leaves the stick off, the keyboard working, until
	  USB power or &tp TP_ON (Fn+F8, "tp on"). In wired mode without USB
	  the stick is left off anyway until USB power or the switch to
	  Bluetooth.

config RETHINK_TRACKPOINT_SAMPLE_RATE
	int "Reports per second on battery"
	default 80
	help
	  PS/2 sample rate: 10, 20, 40, 60, 80, 100 or 200. Battery current
	  with a T420 stick, still: 19.1 mA at 40 and 80/s, 20.3 at 10 and
	  20/s, 20.5 at 100 and 200/s, 21.7 at 60/s. At 200/s its packets
	  still came 10 ms apart. "tp set rate" and, without USB power,
	  &tp TP_RATE_UP/TP_RATE_DN change it; the new rate is kept in flash.

config RETHINK_TRACKPOINT_SAMPLE_RATE_USB
	int "Reports per second with USB power"
	default 100
	help
	  The rate while USB powers the keyboard, where the stick's current
	  costs no battery. 100/s pointed better than 80/s on the T420, and
	  its stick sent no more at 200/s. "tp set rate_usb" and, with USB
	  power, &tp TP_RATE_UP/TP_RATE_DN change it.

config RETHINK_TRACKPOINT_SLOW_IDLE
	bool "80 reports per second while the stick is still (experimental)"
	help
	  After 2 s without movement the stick reports at 80/s; its first
	  movement packet brings the set rate back, with about 10 ms without
	  packets while it changes. For rates that measure the force more
	  often than 80/s per the TrackPoint specification (60, 100, 200).
	  With a T420 stick at 100/s: 19.1 instead of 20.5 mA while still.
	  For sticks where a faster rate is worth having.

config RETHINK_TRACKPOINT_SENSITIVITY
	int "Sensitivity"
	default 192
	range 0 255
	help
	  The stick's force scale before its transfer function: 128 is x1.0,
	  0-255 is x0 to x1.99; 192 is x1.5. The stick's power-on value is 128
	  (the TrackPoint specification, and Linux). Written to the stick after
	  each start; "tp set sensitivity" changes it and keeps it in flash.

config RETHINK_TRACKPOINT_NEG_INERTIA
	int "Negative inertia"
	default 6
	range 0 255
	help
	  Boosts changes of force, so the pointer starts and stops more
	  sharply; 0 is off. Power-on value 6. IBM sticks only (TrackPoint ID
	  01, the T420's), as are the speed and drift time.

config RETHINK_TRACKPOINT_SPEED
	int "Upper plateau speed"
	default 150
	range 0 255
	help
	  Pointer speed under a firm push: about 22 + 4.3 x this counts a
	  second (667 at 150, 439 at the power-on value 97).

config RETHINK_TRACKPOINT_DRIFT_TIME
	int "Drift correction time"
	default 10
	range 1 255
	help
	  Hands off for this long, in 107 ms steps, and the stick takes the
	  present forces as its zero point. Power-on value 5 (0.53 s).

config RETHINK_TRACKPOINT_PRESS_TO_SELECT
	bool "Press-to-select"
	help
	  Pressing the stick clicks. Off at power-on. &tp TP_PTS_TOG switches
	  it (Alt+Fn+F8 on the T420 and L420).

config RETHINK_TRACKPOINT_SCROLL
	bool "Middle button held: the stick scrolls"
	default y
	help
	  While the middle button is held, movement turns into the wheel:
	  each report's stronger axis, vertical, or sideways once that passes
	  RETHINK_TRACKPOINT_SCROLL_H_DEAD_ZONE. Letting the middle button go
	  clicks it only if the stick didn't move. "tp set scroll_divisor" and
	  "tp set scroll_dead_zone" change the numbers and keep them in flash.
	  Turns on ZMK_POINTING_SMOOTH_SCROLLING:
	  the wheel in sixteenths of a step for hosts that set the HID
	  Resolution Multiplier, whole steps for others.

config RETHINK_TRACKPOINT_MIDDLE_SCROLL
	bool "Start with the middle button scrolling"
	default y
	depends on RETHINK_TRACKPOINT_SCROLL
	help
	  Off: the middle button is a plain middle button, also while held,
	  for programs that use it themselves (CAD pans or orbits with it).
	  &tp TP_SCROLL_TOG (Shift+Fn+F8 on the T420 and L420) and "tp set
	  middle_scroll" switch it; the choice is kept in flash.

config RETHINK_TRACKPOINT_SCROLL_DIVISOR
	int "Stick counts per wheel step"
	default 20
	range 1 255
	depends on RETHINK_TRACKPOINT_SCROLL
	help
	  Larger scrolls slower. One wheel step is usually three lines.

config RETHINK_TRACKPOINT_SCROLL_H_DEAD_ZONE
	int "Sideways counts per report that don't scroll"
	default 2
	range 0 127
	depends on RETHINK_TRACKPOINT_SCROLL
	help
	  Horizontal scrolling only for a report with more sideways counts
	  than this, and only from the excess, so a push up that leans a
	  little doesn't scroll sideways. A report with more vertical than
	  sideways counts scrolls only vertically.

config RETHINK_TRACKPOINT_INIT_PRIORITY
	int "Init priority"
	default 92
	help
	  After RETHINK_ADAPTER_INIT_PRIORITY.

config RETHINK_TRACKPOINT_THREAD_STACK_SIZE
	int "Thread stack size"
	default 1024
	help
	  The thread starts the stick after boot, then reports its packets.

config RETHINK_TRACKPOINT_THREAD_PRIORITY
	int "Thread priority"
	default 5

config RETHINK_TRACKPOINT_SHELL
	bool "tp shell commands"
	default y
	depends on SHELL
	help
	  Power the stick, send it bytes and show what it sends, with link
	  error counters and its clock period. The rethink-usb-shell snippet
	  provides the shell.

module = RETHINK_TRACKPOINT
module-str = ReThink pointing stick
source "subsys/logging/Kconfig.template.log_config"

endif # RETHINK_TRACKPOINT

config RETHINK_BLE_SHELL
	bool "ble shell commands"
	default y
	depends on SHELL && ZMK_BLE
	help
	  "ble conn" shows the Bluetooth connection interval the host chose and
	  asks it for another. "ble log" shows the connections since boot
	  (disconnect reasons, encryption, parameters, USB power), after the
	  last reset's cause and record (RETHINK_RESET_DIAG); each event is
	  also logged as rethink_ble. The rethink-usb-shell snippet provides
	  the shell.

config RETHINK_PMIC
	bool "nPM1300: BUCK1 off at boot, \"pmic\" shell command"
	default y
	depends on REGULATOR
	depends on MFD_NPM13XX
	depends on $(dt_nodelabel_enabled,npm1300_buck1)
	help
	  BUCK1 only feeds the backlight switch. The board's
	  regulator-boot-off leaves it running, because Zephyr reads it as off
	  (BUCKSTATUS power-good bit 0 while VO1 is at 3.3 V); from a cell
	  below about 3.4 V it then sits in dropout, drawing about 3 mA. This
	  switches it off with an enable and a disable, leaving its reference
	  count unchanged; the backlight switches it on when it needs it. With
	  a shell, "pmic" shows the bucks' status and the battery current, now
	  and as last read on battery.

config RETHINK_BUCK2_RESTART
	bool "Restart BUCK2 after a change without headroom, and when stuck"
	default y
	depends on RETHINK_PMIC
	help
	  The nPM1300 starts BUCK2 at 3.3 V (VSET2). A change of its voltage
	  from a cell below about 3.35 V (a nearly empty cell, a 3.3 V bench
	  or profiler supply) leaves it in PWM mode with its power good at 0:
	  about 3 mA more, System OFF included, until the input rises or USB
	  comes; switching it off and on clears it. At boot, from a cell under
	  RETHINK_BUCK2_LOW_MV, this sets BUCK2 to 3.0 V and then switches it
	  off and on. At boot and at each battery check (every 10 s), a BUCK2
	  in PWM mode is switched off and on. The two register writes go one
	  after the other; the nRF and the adapter run through the gap on the
	  rail's capacitors. "pmic" shows what was done. If the second write
	  failed, the board would stay off until battery and USB are both
	  disconnected.

config RETHINK_RESET_DIAG
	bool "Record a crash or stall for after the reset"
	default y
	depends on SHELL
	depends on $(dt_nodelabel_enabled,cpuapp_sram)
	select REBOOT
	select THREAD_NAME
	select THREAD_STACK_INFO
	help
	  Reads and clears the reset cause (hwinfo) at boot. Before a reset it
	  records, in the last 256 bytes of RAM, a fatal error (thread, pc,
	  lr, code addresses on its stack; then reboots at once instead of
	  halting until the watchdog) or a stall of the system work queue,
	  which feeds the watchdog (what it waits on, the thread running
	  instead, code addresses on both stacks). "ble log" shows them. A
	  timer checks the work queue twice a second.

DT_COMPAT_RETHINK_BACKLIGHT := rethink,backlight

config RETHINK_BACKLIGHT
	bool "ReThink backlight power chain and PWM"
	default $(dt_compat_enabled,$(DT_COMPAT_RETHINK_BACKLIGHT))
	select LED
	select PWM
	select GPIO
	select REGULATOR

if RETHINK_BACKLIGHT

config RETHINK_BACKLIGHT_TAP_UNLOCK
	bool "Triple tap of the pairing button unlocks the backlight"
	depends on RETHINK_PAIRING_BUTTON
	help
	  For the hardware tester, to try the backlight power chain without a
	  backlit keyboard: bypasses KBD_BL_DTCT until reboot. Keyboards leave
	  it off, so only a detected backlit keyboard unlocks the backlight.

config RETHINK_BACKLIGHT_INIT_PRIORITY
	int "Init priority"
	default 91
	help
	  After RETHINK_ADAPTER_INIT_PRIORITY and the nPM13xx regulators
	  (REGULATOR_NPM13XX_INIT_PRIORITY).

module = RETHINK_BACKLIGHT
module-str = ReThink backlight
source "subsys/logging/Kconfig.template.log_config"

endif # RETHINK_BACKLIGHT

endmenu
