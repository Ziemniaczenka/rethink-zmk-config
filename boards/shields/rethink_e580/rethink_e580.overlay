/*
 * Copyright (c) 2026 Ziemniaczenka
 * SPDX-License-Identifier: MIT
 *
 * ThinkPad E580 keyboard with numpad on FFC2: the 40-pin matrix cable and
 * the 12-pin cable (TrackPoint, backlight), US ANSI or ISO. Mapped with
 * scripts/matrix_scan.py on a US ANSI keyboard (105 keys): the main block
 * is at the T420's positions (rethink_t420), the numpad on DRV16/17 and on
 * SENSE2/3 x DRV9/11/12. The ISO keyboard's # (RC(6,7)) and \ right of
 * LShift (RC(5,1)) are the T420 ISO's, unscanned. 107 positions; the
 * comments name the keys by their UK ISO legends.
 *
 * The Caps Lock and Num Lock LEDs follow the host; the Fn lock, mute and mic
 * mute LEDs rest on their pull-ups. No backlight yet: BUCK1 stays off. The
 * TrackPoint is TP2 as on rethink_t480 (3.3 V), a mouse; its buttons come
 * over the matrix cable (pins 33-35) to the stick.
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include "../rethink_common/rethink_cb.dtsi"
#include "../rethink_common/rethink_adapter.dtsi"
#include "../rethink_common/rethink_adapter_matrix.dtsi"
#include "../rethink_common/rethink_trackpoint.dtsi"

&rethink_adapter {
    capslock-led-gpios = <&rethink_expander RETHINK_EXP_LEDCPSLOCK 0>;
    numlock-led-gpios = <&rethink_expander RETHINK_EXP_LEDNUMLOCK 0>;
};

// The FFC2 stick: TP2, its reset on the expander's P1_1 (R22 pull-up), its
// supply per CONFIG_RETHINK_TP2_SUPPLY_* (3.3 V by default)
&trackpoint {
    tp2;
    reset-gpios = <&rethink_expander RETHINK_EXP_TP2_RST 0>;
};

/ {
    chosen {
        zmk,physical-layout = &rethink_e580_layout;
    };

    rethink_e580_layout: rethink_e580_layout {
        compatible = "zmk,physical-layout";
        display-name = "E580 ANSI/ISO";
        transform = <&rethink_e580_transform>;
    };

    // Keys left to right, row by row; RC(r,c) = SENSEr x DRVc, row 8 = HOTKEY
    // (0)
    rethink_e580_transform: rethink_e580_transform {
        compatible = "zmk,matrix-transform";
        rows = <9>;
        columns = <18>;
        map = <
            // Esc      F1       F2       F3       F4       F5       F6       F7       F8       F9       F10      F11       F12      Home      End       Insert   Delete    KP =      KP (      KP )      KP Bksp
               RC(5,0)  RC(0,1)  RC(0,2)  RC(3,2)  RC(5,2)  RC(5,8)  RC(5,5)  RC(3,6)  RC(0,6)  RC(0,8)  RC(1,8)  RC(1,10)  RC(1,9)  RC(0,12)  RC(1,12)  RC(0,9)  RC(0,10)  RC(3,12)  RC(2,12)  RC(3,11)  RC(2,11)
            // `        1        2        3        4        5        6        7        8        9        0        -        =        Bksp     NmLk      KP /      KP *      KP -
               RC(0,0)  RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(0,3)  RC(0,4)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(0,7)  RC(0,5)  RC(3,8)  RC(5,16)  RC(3,16)  RC(2,16)  RC(0,16)
            // Tab      Q        W        E        R        T        Y        U        I        O        P        [        ]        \ ANSI   KP 7      KP 8      KP 9      KP +
               RC(3,0)  RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(3,3)  RC(3,4)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(3,7)  RC(3,5)  RC(4,8)  RC(4,16)  RC(1,16)  RC(6,16)  RC(7,16)
            // Caps     A        S        D        F        G        H        J        K        L        ;        '        # ISO    Enter    KP 4      KP 5      KP 6
               RC(3,1)  RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)  RC(5,3)  RC(5,4)  RC(4,4)  RC(4,5)  RC(4,6)  RC(4,7)  RC(5,7)  RC(6,7)  RC(6,8)  RC(5,17)  RC(3,17)  RC(2,17)
            // LShift    \ ISO    Z        X        C        V        B        N        M        ,        .        /        RShift    KP 1      KP 2      KP 3      KP Enter
               RC(3,14)  RC(5,1)  RC(6,0)  RC(6,1)  RC(6,2)  RC(6,3)  RC(7,3)  RC(7,4)  RC(6,4)  RC(6,5)  RC(6,6)  RC(7,7)  RC(6,14)  RC(0,17)  RC(4,17)  RC(1,17)  RC(6,17)
            // Fn       LCtrl     Win      LAlt      Space    AltGr     PrtSc     RCtrl     PgUp      Up        PgDn      KP 0      KP .
               RC(8,0)  RC(0,15)  RC(3,9)  RC(5,13)  RC(7,8)  RC(7,13)  RC(1,13)  RC(6,15)  RC(0,11)  RC(5,12)  RC(1,11)  RC(7,17)  RC(2,9)
            // Left      Down      Right
               RC(7,12)  RC(7,10)  RC(7,9)
        >;
    };
};
