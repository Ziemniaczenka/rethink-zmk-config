/*
 * Copyright (c) 2026 Ziemniaczenka
 * SPDX-License-Identifier: MIT
 *
 * ThinkPad L420, ISO. Each key sends the standard key code of its position;
 * the host's layout (Norwegian, UK, ...) gives the legends. The comments name
 * the keys by their UK ISO legends: ` left of 1, # left of Enter (NUHS),
 * \ right of LShift (NUBS).
 * Fn is the bottom-left key, as on the ThinkPad, and does what the keycaps
 * show where a standard key code exists: Break, SysRq, lock (Win+L), sleep,
 * display (Win+P), Scroll Lock, Num Lock, Pause, PrtSc, brightness, browser
 * back/forward on PgUp/PgDn, media on the arrows. Battery, wireless,
 * camera, hibernate and zoom have none and are left out.
 *
 * Fn+F8 (pointing device) switches the TrackPoint on and off; Ctrl+Fn+F8
 * recalibrates it, with the hands off the stick; Alt+Fn+F8 switches
 * press-to-select (clicking by pressing the stick) on and off, kept in
 * flash. Report rate keys
 * (Shift+Fn+F8 up, Ctrl+Shift+Fn+F8 down) are commented out below.
 *
 * Fn+F10 (NmLk) toggles the embedded keypad: the digits on 7-9, U-O, J-L
 * and M, / * - + on 0, P, ; and /. It sends digits and keypad operators,
 * which don't depend on the host's Num Lock.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/rethink/trackpoint.h>

#define NUM 1
#define FN 2

/ {
    behaviors {
        // Fn+F8: TrackPoint on/off, with Ctrl: recalibrate, with Alt:
        // press-to-select on/off
        tp_f8: tp_f8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&tp_f8_ctrl>, <&tp TP_PTS_TOG>;
            mods = <(MOD_LALT|MOD_RALT)>;
        };
        tp_f8_ctrl: tp_f8_ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&tp TP_TOG>, <&tp TP_RECAL>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
        // Report rate keys: &tp_f8_rate instead of &tp_f8 on Fn+F8 adds
        // Shift: rate up a step (10, 20, 40, 60, 80, 100, 200 a second),
        // Ctrl+Shift: down, until the next reset
        // tp_f8_rate: tp_f8_rate {
        //     compatible = "zmk,behavior-mod-morph";
        //     #binding-cells = <0>;
        //     bindings = <&tp_f8>, <&tp_rate>;
        //     mods = <(MOD_LSFT|MOD_RSFT)>;
        // };
        // tp_rate: tp_rate {
        //     compatible = "zmk,behavior-mod-morph";
        //     #binding-cells = <0>;
        //     bindings = <&tp TP_RATE_UP>, <&tp TP_RATE_DN>;
        //     mods = <(MOD_LCTL|MOD_RCTL)>;
        // };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                // Esc      F1      F2      F3      F4      F5      F6      F7      F8      F9      F10      F11      F12      Insert   Delete   Home      End
                   &kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &kp INS  &kp DEL  &kp HOME  &kp END
                // `          1       2       3       4       5       6       7       8       9       0       -          =          Bksp
                   &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &kp EQUAL  &kp BSPC
                // Tab      Q      W      E      R      T      Y      U      I      O      P      [         ]         Enter
                   &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp RET
                // Caps      A      S      D      F      G      H      J      K      L      ;         '        #
                   &kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT  &kp NUHS
                // LShift     \         Z      X      C      V      B      N      M      ,          .        /         RShift
                   &kp LSHFT  &kp NUBS  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                // Fn      LCtrl      Win       LAlt      Space      AltGr     Menu       RCtrl      PgUp       Up      PgDn
                   &mo FN  &kp LCTRL  &kp LGUI  &kp LALT  &kp SPACE  &kp RALT  &kp K_APP  &kp RCTRL  &kp PG_UP  &kp UP  &kp PG_DN
                // Left      Down      Right
                   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        num_layer {
            display-name = "NmLk";
            bindings = <
                // Esc     F1      F2      F3      F4      F5      F6      F7      F8      F9      F10     F11     F12     Insert  Delete  Home    End
                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                // `       1       2       3       4       5       6       7       8       9       0              -       =       Bksp
                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N7  &kp N8  &kp N9  &kp KP_DIVIDE  &trans  &trans  &trans
                // Tab     Q       W       E       R       T       Y       U       I       O       P                [       ]       Enter
                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6  &kp KP_MULTIPLY  &trans  &trans  &trans
                // Caps    A       S       D       F       G       H       J       K       L       ;             '       #
                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N1  &kp N2  &kp N3  &kp KP_MINUS  &trans  &trans
                // LShift  \       Z       X       C       V       B       N       M       ,       .       /            RShift
                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N0  &trans  &trans  &kp KP_PLUS  &trans
                // Fn      LCtrl   Win     LAlt    Space   AltGr   Menu    RCtrl   PgUp    Up      PgDn
                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                // Left    Down    Right
                   &trans  &trans  &trans
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
                // Esc                  F1             F2         F3      F4           F5      F6      F7         F8      F9        F10       F11              F12     Insert     Delete        Home          End
                   &kp LC(PAUSE_BREAK)  &kp LA(PSCRN)  &kp LG(L)  &trans  &kp C_SLEEP  &trans  &trans  &kp LG(P)  &tp_f8  &kp SLCK  &tog NUM  &kp PAUSE_BREAK  &trans  &kp PSCRN  &kp C_BRI_DN  &kp C_BRI_UP  &trans
                // `       1       2       3       4       5       6       7       8       9       0       -       =       Bksp
                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                // Tab     Q       W       E       R       T       Y       U       I       O       P       [       ]       Enter
                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                // Caps    A       S       D       F       G       H       J       K       L       ;       '       #
                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                // LShift  \       Z       X       C       V       B       N       M       ,       .       /       RShift
                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                // Fn      LCtrl   Win     LAlt    Space   AltGr   Menu    RCtrl   PgUp           Up          PgDn
                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp C_AC_BACK  &kp C_STOP  &kp C_AC_FORWARD
                // Left        Down      Right
                   &kp C_PREV  &kp C_PP  &kp C_NEXT
            >;
        };
    };
};
