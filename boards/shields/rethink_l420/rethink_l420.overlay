/*
 * Copyright (c) 2026 Ziemniaczenka
 * SPDX-License-Identifier: MIT
 *
 * ThinkPad L420 keyboard on FFC1: the 30-pin matrix cable in J4. ISO, 85
 * keys, mapped with scripts/matrix_scan.py on two Norwegian L420 keyboards;
 * the comments name the keys by their UK ISO legends.
 * The TrackPoint and its buttons are on the 8-pin cable (J5), not in the
 * matrix: TP1, a mouse.
 * The keyboard has no backlight and no
 * status LEDs: BUCK1 stays off from boot and the expander's LED pins rest on
 * their pull-ups.
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include "../rethink_common/rethink_cb.dtsi"
#include "../rethink_common/rethink_adapter.dtsi"
#include "../rethink_common/rethink_adapter_matrix.dtsi"
#include "../rethink_common/rethink_trackpoint.dtsi"

/ {
    chosen {
        zmk,physical-layout = &l420_layout;
    };

    l420_layout: l420_layout {
        compatible = "zmk,physical-layout";
        display-name = "L420 ISO";
        transform = <&l420_transform>;
    };

    // Keys left to right, row by row; RC(r,c) = SENSEr x DRVc
    l420_transform: l420_transform {
        compatible = "zmk,matrix-transform";
        rows = <9>;
        columns = <18>;
        map = <
            // Esc     F1       F2       F3       F4       F5       F6       F7       F8       F9       F10      F11      F12      Insert   Delete   Home     End
            RC(0,0)  RC(3,2)  RC(3,1)  RC(1,1)  RC(0,1)  RC(0,10) RC(0,6)  RC(1,7)  RC(3,7)  RC(3,10) RC(5,10) RC(5,11) RC(5,13) RC(3,11) RC(5,14) RC(5,15) RC(3,15)
            // `       1        2        3        4        5        6        7        8        9        0        -        =        Bksp
            RC(3,0)  RC(5,0)  RC(5,2)  RC(5,1)  RC(5,4)  RC(3,4)  RC(3,5)  RC(5,5)  RC(5,6)  RC(5,7)  RC(5,8)  RC(3,8)  RC(3,6)  RC(1,10)
            // Tab     Q        W        E        R        T        Y        U        I        O        P        [        ]        Enter
            RC(1,0)  RC(2,0)  RC(2,2)  RC(2,1)  RC(2,4)  RC(1,4)  RC(1,5)  RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(1,8)  RC(1,6)  RC(6,10)
            // Caps    A        S        D        F        G        H        J        K        L        ;        '        #
            RC(1,2)  RC(4,0)  RC(4,2)  RC(4,1)  RC(4,4)  RC(0,4)  RC(0,5)  RC(4,5)  RC(4,6)  RC(4,7)  RC(4,8)  RC(0,8)  RC(6,8)
            // LShift  \        Z        X        C        V        B        N        M        ,        .        /        RShift
            RC(1,9)  RC(0,2)  RC(6,0)  RC(6,2)  RC(6,1)  RC(6,4)  RC(7,4)  RC(7,5)  RC(6,5)  RC(6,6)  RC(6,7)  RC(7,8)  RC(6,9)
            // Fn      LCtrl    Win      LAlt     Space    AltGr    Menu     RCtrl    PgUp     Up       PgDn
            RC(4,14) RC(3,3)  RC(1,13) RC(0,12) RC(7,10) RC(7,12) RC(4,15) RC(6,3)  RC(6,15) RC(0,14) RC(7,15)
            // Left    Down     Right
            RC(7,14) RC(7,11) RC(7,13)
        >;
    };
};
