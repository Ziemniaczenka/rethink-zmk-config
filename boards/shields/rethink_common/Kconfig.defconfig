#
# Defaults for every rethink_* shield. Zephyr reads the Kconfig.defconfig of
# every folder under boards/shields, so this one needs no shield of its own,
# and reads them before the modules' Kconfig files, so these defaults win.

# framework-cb keeps the blue LED on while connected; RETHINK_CONNECTED_LED
# lights it for a few seconds after connecting instead
config FRAMEWORK_CB_STATUS_LED
    default n

# Shields with a pointing stick (rethink_trackpoint.dtsi) report it as a mouse
RETHINK_DEFCONFIG_TRACKPOINT := rethink,trackpoint

config ZMK_POINTING
    default $(dt_compat_enabled,$(RETHINK_DEFCONFIG_TRACKPOINT))

# The stick scrolls in sixteenths of a step for hosts that set the HID
# Resolution Multiplier (patches/zmk/0001-*)
config ZMK_POINTING_SMOOTH_SCROLLING
    default RETHINK_TRACKPOINT_SCROLL

# The Bluetooth RX work queue runs the connection callbacks (ZMK's, the log,
# pairing data to flash). Zephyr's 1200 bytes were used up entirely ("kernel
# thread stacks" on the T420 shell build, 2026-11-10)
config BT_RX_STACK_SIZE
    default 2048

# A fatal error reboots at once instead of halting until the watchdog resets
# the board 8 s later. Shell builds record it first (src/reset_diag.c).
config RESET_ON_FATAL_ERROR
    default y
