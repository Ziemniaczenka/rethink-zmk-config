/*
 * Copyright (c) 2026 Ziemniaczenka
 * SPDX-License-Identifier: MIT
 *
 * The whole matrix the adapter carries: SENSE0-7 (P0.00-P0.07) by DRV0-14
 * (Control Board) and DRV15-17 (expander P0_4-P0_6), plus HOTKEY and
 * PWRSWITCH (expander P0_2, P0_3) as direct keys in row 8. Columns are
 * open-drain and ghost keys are blocked, for diodeless ThinkPad matrices.
 * Row r, column c = position r*18 + c; HOTKEY and PWRSWITCH are 144, 145.
 *
 * Include after rethink_adapter.dtsi. KSO15/16 (P1.15/P1.16) are the
 * TrackPoint PS/2 lines and KSO17 (P1.17) the backlight PWM, so DRV15-17
 * come from the expander instead.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,matrix-input = &matrix;
        zmk,physical-layout = &adapter_matrix_layout;
    };

    adapter_matrix_layout: adapter_matrix_layout {
        compatible = "zmk,physical-layout";
        display-name = "Adapter matrix 8x18 + 2";
        transform = <&adapter_matrix_transform>;
    };

    adapter_matrix_transform: adapter_matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <9>;
        columns = <18>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15) RC(1,16) RC(1,17)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15) RC(2,16) RC(2,17)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15) RC(3,16) RC(3,17)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15) RC(4,16) RC(4,17)
            RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(5,7) RC(5,8) RC(5,9) RC(5,10) RC(5,11) RC(5,12) RC(5,13) RC(5,14) RC(5,15) RC(5,16) RC(5,17)
            RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5) RC(6,6) RC(6,7) RC(6,8) RC(6,9) RC(6,10) RC(6,11) RC(6,12) RC(6,13) RC(6,14) RC(6,15) RC(6,16) RC(6,17)
            RC(7,0) RC(7,1) RC(7,2) RC(7,3) RC(7,4) RC(7,5) RC(7,6) RC(7,7) RC(7,8) RC(7,9) RC(7,10) RC(7,11) RC(7,12) RC(7,13) RC(7,14) RC(7,15) RC(7,16) RC(7,17)
            RC(8,0) RC(8,1)
        >;
    };

    matrix: matrix {
        compatible = "rethink,matrix";
        wakeup-source;
        ghost-key-blocking;

        // SENSE0-7 / KSI0-7
        row-gpios
            = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            , <&gpio0 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;

        // DRV0-14 / KSO0-14
        col-gpios
            = <&gpio1 0 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 1 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 18 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 19 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 4 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 5 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 7 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 8 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 9 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            , <&gpio1 14 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>
            ;

        // DRV15-17, columns 15-17
        expander-col-gpios
            = <&rethink_expander 4 0>
            , <&rethink_expander 5 0>
            , <&rethink_expander 6 0>
            ;

        // HOTKEY, PWRSWITCH: row 8, columns 0 and 1
        direct-gpios
            = <&rethink_expander 2 0>
            , <&rethink_expander 3 0>
            ;

        // TP_INT: U1's open-drain INT, R3 pull-up on the adapter
        int-gpios = <&gpio3 6 GPIO_ACTIVE_LOW>;
    };
};
