/*
 * Copyright (c) 2026 Ziemniaczenka
 * SPDX-License-Identifier: MIT
 *
 * ThinkPad T420 keyboard on the Mezzanine connector (2x20 pins). ISO, 96
 * keys: the keyboard, the volume, mic mute and ThinkVantage buttons above
 * it, Fn on HOTKEY and the power button on PWRSWITCH. Mapped with
 * scripts/matrix_scan.py on a Norwegian T420 keyboard; the comments name the
 * keys by their UK ISO legends.
 *
 * KBDID0-2 (Mezzanine 25, 27, 29) meet the adapter's backlight PWM, GND and
 * BL_5V: no backlight here, so P1.17 stays unused and JP3 must stay open.
 * The Caps Lock LED (Mezzanine 21) follows the host; the power, mute and mic
 * mute LEDs rest on their pull-ups. The TrackPoint (Mezzanine 37-40) is TP1,
 * a mouse; its three buttons under the space bar are wired to the stick.
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include "../rethink_common/rethink_cb.dtsi"
#include "../rethink_common/rethink_adapter.dtsi"
#include "../rethink_common/rethink_adapter_matrix.dtsi"
#include "../rethink_common/rethink_trackpoint.dtsi"

&rethink_adapter {
    capslock-led-gpios = <&rethink_expander RETHINK_EXP_LEDCPSLOCK 0>;
};

/ {
    chosen {
        zmk,physical-layout = &t420_layout;
    };

    t420_layout: t420_layout {
        compatible = "zmk,physical-layout";
        display-name = "T420 ISO";
        transform = <&t420_transform>;
    };

    // Keys left to right, row by row; RC(r,c) = SENSEr x DRVc, row 8 = HOTKEY
    // (0) and PWRSWITCH (1)
    t420_transform: t420_transform {
        compatible = "zmk,matrix-transform";
        rows = <9>;
        columns = <18>;
        map = <
            // Esc      Mute      VolDn     VolUp     MicMute   ThinkVantage  Power    PrtSc     ScrLk     Pause     Insert   Delete    Home      PgUp
               RC(5,0)  RC(4,10)  RC(3,10)  RC(2,10)  RC(6,10)  RC(5,10)      RC(8,1)  RC(1,13)  RC(2,13)  RC(6,12)  RC(0,9)  RC(0,10)  RC(0,12)  RC(0,11)
            // F1       F2       F3       F4       F5       F6       F7       F8       F9       F10      F11       F12      End       PgDn
               RC(0,1)  RC(0,2)  RC(3,2)  RC(5,2)  RC(5,8)  RC(5,5)  RC(3,6)  RC(0,6)  RC(0,8)  RC(1,8)  RC(1,10)  RC(1,9)  RC(1,12)  RC(1,11)
            // `        1        2        3        4        5        6        7        8        9        0        -        =        Bksp
               RC(0,0)  RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(0,3)  RC(0,4)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(0,7)  RC(0,5)  RC(3,8)
            // Tab      Q        W        E        R        T        Y        U        I        O        P        [        ]        Enter
               RC(3,0)  RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(3,3)  RC(3,4)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(3,7)  RC(3,5)  RC(6,8)
            // Caps     A        S        D        F        G        H        J        K        L        ;        '        #
               RC(3,1)  RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)  RC(5,3)  RC(5,4)  RC(4,4)  RC(4,5)  RC(4,6)  RC(4,7)  RC(5,7)  RC(6,7)
            // LShift    \        Z        X        C        V        B        N        M        ,        .        /        RShift
               RC(3,14)  RC(5,1)  RC(6,0)  RC(6,1)  RC(6,2)  RC(6,3)  RC(7,3)  RC(7,4)  RC(6,4)  RC(6,5)  RC(6,6)  RC(7,7)  RC(6,14)
            // Fn       LCtrl     Win      LAlt      Space    AltGr     Menu      RCtrl     Back      Up        Forward
               RC(8,0)  RC(0,15)  RC(3,9)  RC(5,13)  RC(7,8)  RC(7,13)  RC(4,11)  RC(6,15)  RC(6,11)  RC(5,12)  RC(7,11)
            // Left      Down      Right
               RC(7,12)  RC(7,10)  RC(7,9)
        >;
    };
};
