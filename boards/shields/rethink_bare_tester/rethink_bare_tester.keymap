/*
 * SPDX-License-Identifier: MIT
 *
 * One distinct key per matrix position, row by row, so any HID key tester
 * shows which KSI/KSO pair was shorted. Row r, column c = position r*15 + c.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp A           &kp B           &kp C           &kp D           &kp E           &kp F           &kp G           &kp H           &kp I           &kp J           &kp K           &kp L           &kp M           &kp N           &kp O
                &kp P           &kp Q           &kp R           &kp S           &kp T           &kp U           &kp V           &kp W           &kp X           &kp Y           &kp Z           &kp N1          &kp N2          &kp N3          &kp N4
                &kp N5          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0          &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9
                &kp F10         &kp F11         &kp F12         &kp F13         &kp F14         &kp F15         &kp F16         &kp F17         &kp F18         &kp F19         &kp F20         &kp F21         &kp F22         &kp F23         &kp F24
                &kp RET         &kp ESC         &kp BSPC        &kp TAB         &kp SPACE       &kp MINUS       &kp EQUAL       &kp LBKT        &kp RBKT        &kp BSLH        &kp SEMI        &kp SQT         &kp GRAVE       &kp COMMA       &kp DOT
                &kp FSLH        &kp CAPS        &kp PSCRN       &kp SLCK        &kp PAUSE_BREAK &kp INS         &kp HOME        &kp PG_UP       &kp DEL         &kp END         &kp PG_DN       &kp RIGHT       &kp LEFT        &kp DOWN        &kp UP
                &kp KP_NUM      &kp KP_DIVIDE   &kp KP_MULTIPLY &kp KP_MINUS    &kp KP_PLUS     &kp KP_ENTER    &kp KP_N1       &kp KP_N2       &kp KP_N3       &kp KP_N4       &kp KP_N5       &kp KP_N6       &kp KP_N7       &kp KP_N8       &kp KP_N9
                &kp KP_N0       &kp KP_DOT      &kp K_APP       &kp LCTRL       &kp LSHFT       &kp LALT        &kp LGUI        &kp RCTRL       &kp RSHFT       &kp RALT        &kp RGUI        &kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_PP
            >;
        };
    };
};
