/*
 * Copyright (c) 2026 Ziemniaczenka
 * SPDX-License-Identifier: MIT
 *
 * ThinkPad T480, UK ISO or US ANSI. Each key sends the standard key code of
 * its position; the host's layout (Norwegian, UK, US, ...) gives the
 * legends. The comments name the keys by their UK ISO legends: ` left of 1,
 * # left of Enter (NUHS), \ right of LShift (NUBS); "\ ANSI" is the ANSI
 * keyboard's \ above Enter (BSLH). The ISO keyboard lacks \ ANSI, the ANSI
 * one # and \ right of LShift.
 *
 * F1-F12 send F1-F12. Fn does what the keycaps show where a standard key
 * code exists: mute, volume down/up, mic mute (F20, which Linux treats as mic
 * mute), brightness down/up, display (Win+P) and settings (Win+I) on F1-F9,
 * and the ThinkPad's sleep on 4, ScrLk on K, Pause on P, Break on B, SysRq
 * on S, the snipping tool (Win+Shift+S) on PrtSc. Fn lock (Fn+Esc and its
 * LED), Bluetooth, keyboard settings, the star key and the backlight
 * (Fn+Space) are left out for now.
 *
 * Fn+F8 (airplane mode on the keycap, which has no key code) switches the
 * TrackPoint on and off; Ctrl+Fn+F8 recalibrates it, with the hands off the
 * stick; Shift+Fn+F8 switches scrolling with the middle button held on and
 * off (off: a plain middle button, for programs that pan with it), kept in
 * flash. The T480's and E580's sticks have no press-to-select (clicking by
 * pressing the stick), so Alt+Fn+F8 isn't bound to it.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/rethink/trackpoint.h>

#define FN 1

/ {
    behaviors {
        // Fn+F8: TrackPoint on/off; with Ctrl: recalibrate; with Shift:
        // middle-button scrolling on/off. No press-to-select: this
        // generation's sticks lack it
        tp_f8: tp_f8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&tp_f8_ctrl>, <&tp TP_SCROLL_TOG>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        tp_f8_ctrl: tp_f8_ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&tp TP_TOG>, <&tp TP_RECAL>;
            mods = <(MOD_LCTL|MOD_RCTL)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
                // Esc      F1      F2      F3      F4      F5      F6      F7      F8      F9      F10      F11      F12      Home      End      Insert   Delete
                   &kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &kp HOME  &kp END  &kp INS  &kp DEL
                // `          1       2       3       4       5       6       7       8       9       0       -          =          Bksp
                   &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &kp MINUS  &kp EQUAL  &kp BSPC
                // Tab      Q      W      E      R      T      Y      U      I      O      P      [         ]         \ ANSI    Enter
                   &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp BSLH  &kp RET
                // Caps      A      S      D      F      G      H      J      K      L      ;         '        # ISO
                   &kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT  &kp NUHS
                // LShift     \ ISO     Z      X      C      V      B      N      M      ,          .        /         RShift
                   &kp LSHFT  &kp NUBS  &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                // Fn      LCtrl      Win       LAlt      Space      AltGr     PrtSc      RCtrl      PgUp       Up      PgDn
                   &mo FN  &kp LCTRL  &kp LGUI  &kp LALT  &kp SPACE  &kp RALT  &kp PSCRN  &kp RCTRL  &kp PG_UP  &kp UP  &kp PG_DN
                // Left      Down      Right
                   &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
                // Esc     F1          F2            F3            F4       F5            F6            F7         F8      F9         F10     F11     F12     Home    End     Insert  Delete
                   &trans  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp F20  &kp C_BRI_DN  &kp C_BRI_UP  &kp LG(P)  &tp_f8  &kp LG(I)  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                // `       1       2       3       4            5       6       7       8       9       0       -       =       Bksp
                   &trans  &trans  &trans  &trans  &kp C_SLEEP  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                // Tab     Q       W       E       R       T       Y       U       I       O       P                [       ]       \ ANSI  Enter
                   &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PAUSE_BREAK  &trans  &trans  &trans  &trans
                // Caps    A       S              D       F       G       H       J       K         L       ;       '       # ISO
                   &trans  &trans  &kp LA(PSCRN)  &trans  &trans  &trans  &trans  &trans  &kp SLCK  &trans  &trans  &trans  &trans
                // LShift  \ ISO   Z       X       C       V       B                    N       M       ,       .       /       RShift
                   &trans  &trans  &trans  &trans  &trans  &trans  &kp LC(PAUSE_BREAK)  &trans  &trans  &trans  &trans  &trans  &trans
                // Fn      LCtrl   Win     LAlt    Space   AltGr   PrtSc          RCtrl   PgUp    Up      PgDn
                   &trans  &trans  &trans  &trans  &trans  &trans  &kp LG(LS(S))  &trans  &trans  &trans  &trans
                // Left    Down    Right
                   &trans  &trans  &trans
            >;
        };
    };
};
